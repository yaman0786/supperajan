# ============================================================
# SUPPERAJAN PLATFORM — ENVIRONMENT VARIABLE REFERENCE
# Copy this file to .env.local for local development.
# Never commit real secrets.
# ============================================================

# --- Node environment ---
NODE_ENV=development

# --- App URLs ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000

# --- Database (PostgreSQL + pgvector) ---
DATABASE_URL=postgresql://supperajan:supperajan@localhost:5432/supperajan_dev
DATABASE_DIRECT_URL=postgresql://supperajan:supperajan@localhost:5432/supperajan_dev

# --- Redis ---
REDIS_URL=redis://localhost:6379
REDIS_PREFIX=supperajan:

# --- Auth (JWT) ---
JWT_SECRET=change_me_in_production_minimum_32_chars
JWT_EXPIRY=7d
REFRESH_TOKEN_SECRET=change_refresh_secret_minimum_32_chars
REFRESH_TOKEN_EXPIRY=30d

# --- LLM Provider (OpenAI-compatible) ---
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=https://api.openai.com/v1
# Anthropic (alternative provider)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-4-7

# --- STT Provider ---
STT_PROVIDER=openai
# Deepgram (alternative)
DEEPGRAM_API_KEY=

# --- TTS Provider ---
TTS_PROVIDER=openai
TTS_VOICE=alloy
# ElevenLabs (alternative)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- Embeddings Provider ---
EMBEDDINGS_PROVIDER=openai
EMBEDDINGS_MODEL=text-embedding-3-small
EMBEDDINGS_DIMENSIONS=1536

# --- Vector Store ---
VECTOR_STORE_PROVIDER=pgvector
# Qdrant (alternative)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# --- File Storage (S3-compatible) ---
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./uploads
S3_BUCKET=supperajan-uploads
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=

# --- Observability ---
LOG_LEVEL=debug
LOG_FORMAT=pretty
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# --- Session ---
SESSION_SECRET=change_me_session_secret_32_chars
CORS_ORIGINS=http://localhost:3000
