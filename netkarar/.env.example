# --- Backend ---
# Bind host/port for uvicorn
NETKARAR_HOST=127.0.0.1
NETKARAR_PORT=8000

# Comma separated list of origins allowed by CORS
NETKARAR_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Absolute or relative path to the SQLite file (default: ./data/netkarar.db)
# NETKARAR_DB_PATH=

# --- Frontend ---
# Base URL the browser uses to reach the API
VITE_API_BASE=http://127.0.0.1:8000
